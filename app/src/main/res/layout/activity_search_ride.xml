<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".SearchRideActivity">

    <!-- ============ TOP BAR ============ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curve"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_ride_screen_title"
                android:textColor="@color/text_on_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/search_ride_screen_subtitle"
                android:textColor="@color/text_on_dark"
                android:textSize="13sp"
                android:alpha="0.7" />

        </LinearLayout>

    </RelativeLayout>

    <!-- ============ SCROLLABLE BODY ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ======== SEARCH FORM CARD ======== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.CardView"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- From -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/selector_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location_pickup"
                            android:contentDescription="From" />

                        <EditText
                            android:id="@+id/etFrom"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/hint_from"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:maxLines="1" />

                    </LinearLayout>

                    <View
                        android:layout_width="1.5dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="22dp"
                        android:background="@color/border_divider" />

                    <!-- To -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/selector_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location_drop"
                            android:contentDescription="To" />

                        <EditText
                            android:id="@+id/etTo"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/hint_to"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:maxLines="1" />

                    </LinearLayout>

                    <!-- Date + Seats row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- Date -->
                        <LinearLayout
                            android:id="@+id/layoutSearchDate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_calendar"
                                android:contentDescription="Date" />

                            <TextView
                                android:id="@+id/tvSearchDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/hint_select_date"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:maxLines="1" />

                        </LinearLayout>

                        <!-- Seats needed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_seats_needed"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:id="@+id/layoutSearchSeats"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chipSearchSeat1"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="3dp"
                                    android:background="@drawable/bg_seat_selector"
                                    android:gravity="center"
                                    android:text="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipSearchSeat2"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:layout_marginEnd="3dp"
                                    android:background="@drawable/bg_seat_selector"
                                    android:gravity="center"
                                    android:text="2"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipSearchSeat3"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:layout_marginEnd="3dp"
                                    android:background="@drawable/bg_seat_selector"
                                    android:gravity="center"
                                    android:text="3"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipSearchSeat4"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/bg_seat_selector"
                                    android:gravity="center"
                                    android:text="4"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Search Button -->
                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_search_button"
                        android:text="@string/btn_search"
                        android:textColor="@color/text_on_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ======== FILTER BAR ======== -->
            <LinearLayout
                android:id="@+id/layoutFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="@string/filter_all"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterCar"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="@string/vehicle_car"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipFilterSuv"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="@string/vehicle_suv"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipFilterVan"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="@string/vehicle_van"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipFilterAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center"
                            android:text="@string/vehicle_auto"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Sort row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_sort"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Sort" />

                    <TextView
                        android:id="@+id/tvSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_price_low"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ======== RESULTS SECTION ======== -->
            <LinearLayout
                android:id="@+id/layoutResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- No results message -->
            <TextView
                android:id="@+id/tvNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_no_results"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>